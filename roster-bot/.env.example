# Copy to .env and fill in values
DISCORD_TOKEN=your-bot-token-here

# Optional — defaults to INFO
LOG_LEVEL=INFO

# ── Postgres (used in docker-compose; defaults are fine for self-hosted) ──
# The bot service derives DATABASE_URL from these.
POSTGRES_USER=roster
POSTGRES_PASSWORD=roster
POSTGRES_DB=roster

# For local development (running `uv run python -m bot` directly, no compose),
# point this at any reachable Postgres:
# DATABASE_URL=postgresql://roster:roster@localhost:5432/roster

# ── Google Sheets auth ──
# Required for /sheets stat boards AND /market-admin results import.
# Full walkthrough: see "Google Sheets access" in README.md.
#
# Docker note: if you use the PATH form below, the path must exist INSIDE the
# container. Uncomment the volumes block in docker-compose.yml and use
# /run/secrets/service-account.json, or paste the raw JSON instead.
#
# Option 1 — Service account (recommended, works with private sheets)
#   Set to the path of your downloaded service account JSON key file:
#     GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
#   OR paste the entire JSON contents as a single line:
#     GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}
#   Then share the spreadsheet with the service account email (Viewer access).
#
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Option 2 — Simple API key (only works for publicly shared sheets)
#   See: https://console.cloud.google.com/apis/credentials
#
# GOOGLE_SHEETS_API_KEY=AIza...
